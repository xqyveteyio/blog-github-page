	width=&#34;1116&#34;
	height=&#34;2480&#34;
	srcset=&#34;https://keyboard2005.github.io/posts/2025/%E5%85%B3%E4%BA%8E%E6%88%91/images/11_hu_9cd11a976f4e017.jpg 480w, https://keyboard2005.github.io/posts/2025/%E5%85%B3%E4%BA%8E%E6%88%91/images/11_hu_91e2b3b35020821a.jpg 1024w&#34;
